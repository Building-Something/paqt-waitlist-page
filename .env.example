# Copy this file to .env and fill in your real values.
MONGODB_USER=your_db_user
MONGODB_PASSWORD=your_password_plain_text
MONGODB_CLUSTER=cluster0.xxxxxxx.mongodb.net
DB_NAME=paqt
# Alternatively set a pre-encoded full URI and leave the three fields above blank:
# MONGODB_URI=mongodb+srv://user:encoded%20password@cluster.mongodb.net/?appName=Cluster0
PORT=5000
# Google Analytics 4 measurement ID (starts with G-). Blank/placeholder = analytics disabled.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX